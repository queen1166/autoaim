# ── 构建产物 ──────────────────────────────────────────
build/
build-*/
cmake-build-*/
compile_commands.json
*.o
*.obj
*.a
*.lib
*.so
*.so.*
*.dylib
*.exe

# ── Python ────────────────────────────────────────────
__pycache__/
*.py[cod]
